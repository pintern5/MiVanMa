  "components": {
    "schemas": {
      "ArticleDto": {
        "required": [
          "title",
          "summary",
          "content",
          "imageUrl",
          "category"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "content": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": "string"
          },
          "isFeatured": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "AuthDto": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
