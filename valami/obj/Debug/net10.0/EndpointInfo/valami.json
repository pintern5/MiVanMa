  "paths": {
    "/api/news": {
      "get": {
        "tags": [
          "Hírek"
        ],
        "operationId": "GetNews",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Hírek"
        ],
        "operationId": "CreateNews",
